{
  "rules": {
    "apps": {
      "$app": {
        "users": {
          ".read": "auth != null",
          ".indexOn": [
            "puan",
            "tp"
          ],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['ad','puan'])",
            "ad": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 18 && (newData.val() === root.child('hesap').child($uid).child('ad').val() || (!root.child('hesap').child($uid).exists() && newData.val().matches(/^Oyuncu[0-9]{4}$/)))"
            },
            "puan": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
            },
            "tp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000000"
            },
            "tz": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100000"
            },
            "lig": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
            }
          }
        },
        "online": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "invites": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$id": {
              ".read": "auth != null && (auth.uid === $to || data.child('from').val() === auth.uid)",
              ".write": "auth != null && (auth.uid === $to || data.child('from').val() === auth.uid || (!data.exists() && newData.child('from').val() === auth.uid))"
            }
          }
        },
        "duels": {
          ".read": "auth != null",
          "$id": {
            ".write": "auth != null && (data.exists() ? (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid) : (newData.child('a').val() === auth.uid || newData.child('b').val() === auth.uid))"
          }
        },
        "meydan": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "turnuva": {
          ".read": "auth != null",
          ".indexOn": [
            "durum"
          ],
          "$id": {
            ".write": "auth != null"
          }
        },
        "sayac": {
          ".read": "auth != null",
          "toplam": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
          }
        },
        "sayacUye": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true"
          }
        },
        "oyunSayi": {
          ".read": "auth != null",
          "$gun": {
            ".write": "auth != null",
            ".validate": "$gun.matches(/^[0-9]{8}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
          }
        },
        "haftaSayi": {
          ".read": "auth != null",
          "$hafta": {
            ".write": "auth != null",
            ".validate": "$hafta.matches(/^[0-9]{8}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
          }
        },
        "haftaUye": {
          "$hafta": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists()",
              ".validate": "$hafta.matches(/^[0-9]{8}$/) && newData.val() === true"
            }
          }
        },
        "haftaOyun": {
          ".read": "auth != null",
          "$hafta": {
            ".write": "auth != null",
            ".validate": "$hafta.matches(/^[0-9]{8}$/) && newData.isNumber() && newData.val() === (data.exists() ? data.val() + 1 : 1)"
          }
        },
        "ligPuan": {
          ".read": "auth != null",
          "$hafta": {
            "$lig": {
              ".indexOn": [
                "p"
              ],
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "newData.hasChildren(['ad','p']) && newData.child('p').isNumber() && newData.child('p').val() >= 0 && newData.child('p').val() < 1000000 && newData.child('ad').isString() && newData.child('ad').val().length <= 18"
              }
            }
          }
        }
      }
    },
    "adlar": {
      "$k": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email != null && ((!data.exists() && newData.val() === auth.uid && $k.matches(/^[a-z][a-z0-9_]{2,17}$/) && (!$k.matches(/^(fk1453|fatih|fatih_|fatihkoc81|fatihkoc7|estergon)$/) || (auth.token.email_verified === true && auth.token.email === 'fatihkoc7@gmail.com')) && (!$k.matches(/^(hatice|haticekoc81|haticekoc1|haticekoc7)$/) || (auth.token.email_verified === true && (auth.token.email === 'haticekoc7x@gmail.com' || auth.token.email === 'fatihkoc7@gmail.com'))) && (root.child('hesap').child(auth.uid).child('adT').val() == null || now - root.child('hesap').child(auth.uid).child('adT').val() >= 1296000000)) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "hesap": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['ad','adT'])",
        "ad": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 18 && newData.val().matches(/^[A-Z]([a-z0-9_]*[A-Z])?[a-z0-9_]*$/) && root.child('adlar').child(newData.val().toLowerCase()).val() === $uid && (!data.exists() || data.val() === newData.val() || now - data.parent().child('adT').val() >= 1296000000)"
        },
        "adT": {
          ".validate": "newData.isNumber() && (newData.parent().child('ad').val() === data.parent().child('ad').val() ? newData.val() === data.val() : newData.val() === now)"
        },
        "$other": {
          ".validate": "false"
        }
      }
    }
  }
}